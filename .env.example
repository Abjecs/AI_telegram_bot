# Required
TELEGRAM_TOKEN=
GIGACHAT_CREDENTIALS=
DATABASE_URL=

# Deployment / webhook
PORT=8080
RENDER_EXTERNAL_HOSTNAME=
# Optional. If omitted, a fresh secret is generated on startup.
WEBHOOK_SECRET=
# Optional full public URL, e.g. https://example.onrender.com
WEBHOOK_URL=

# GigaChat
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_VERIFY_SSL_CERTS=true
AI_TIMEOUT=60
AI_MAX_RETRIES=2
AI_RETRY_BACKOFF=1
AI_MAX_INPUT_CHARS=12000
AI_MAX_OUTPUT_CHARS=12000
AI_HISTORY_MESSAGES=8
AI_MAX_CONCURRENT=3
AI_RATE_LIMIT=10
AI_RATE_WINDOW_SECONDS=60

# Reminders
APP_TIMEZONE=UTC
REMINDER_POLL_SECONDS=5

# Storage limits
MAX_USER_FILES=50
MAX_FILE_NAME_CHARS=255

# Optional legacy integrations
NEWS_API_KEY=
TGSTAT_API_TOKEN=
STORAGE_CHANNEL_ID=
IMGFLIP_USERNAME=
IMGFLIP_PASSWORD=
