# Telegram
TELEGRAM_TOKEN=

# Bybit API - create a key with Read + Trade only. NEVER enable Withdraw.
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_BASE_URL=https://api.bybit.com
BYBIT_RECV_WINDOW=5000

# Market
SYMBOL=BTCUSDT

# Trading safety
TRADING_ENABLED=true
DRY_RUN=true
# 0 = use current Bybit USDT wallet balance; any positive value = fixed strategy capital.
CAPITAL_USDT=0
RISK_PER_TRADE_PCT=0.5
MAX_POSITION_NOTIONAL_PCT=100
MAX_DAILY_LOSS_USDT=0
LEVERAGE=3
POLL_SECONDS=20
MIN_SIGNAL_SCORE=6
ATR_STOP_MULTIPLIER=1.5
ATR_TP_MULTIPLIER=2.5

# OpenAI API. GPT-5.6 Luna is the cost-sensitive default.
AI_ENABLED=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5.6-luna

# Render webhook
PORT=8080
RENDER_EXTERNAL_HOSTNAME=
WEBHOOK_URL=
WEBHOOK_SECRET=
LOG_LEVEL=INFO
